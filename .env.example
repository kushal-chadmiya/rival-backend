PORT=8080
FRONTEND_URL=http://localhost:3000
# Use the Session pooler string from Supabase Dashboard > Connect if direct IPv6 fails.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Required for file uploads via Supabase Storage (server-side only).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional if your project uses the shared JWT secret instead of JWKS verification.
SUPABASE_JWT_SECRET=
# Optional override. If empty, the backend derives it from SUPABASE_URL.
SUPABASE_JWKS_URL=
STORAGE_BUCKET=task-attachments
MAX_UPLOAD_BYTES=10485760
# Allow any signed-in user to switch to admin view via X-View-Role (assessment/demo).
ALLOW_VIEW_AS_ADMIN=true
